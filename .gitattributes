# 换行：入库统一 LF，检出按平台自动
* text=auto

# 明确按文本处理的文件
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
LICENSE text eol=lf

# Windows 脚本保持 CRLF，避免 cmd/pwsh 解析出错
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制，不做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.zip   binary
